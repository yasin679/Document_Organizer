{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "DocumentOrganizer": {
    "DataPath": "data",
    "SessionTimeoutMinutes": 30,
    "EnableDemoData": true,
    "BehindReverseProxy": false,
    "AllowedLocalRoots": [],
    "StorageConnections": {
      "Azurite": {
        "Provider": "AzureBlob",
        "ConnectionString": "UseDevelopmentStorage=true",
        "Description": "Local Azure Blob emulator (Azurite) for testing",
        "UseForDemo": true
      },
      "LocalS3": {
        "Provider": "S3",
        "ServiceUrl": "http://localhost:9000",
        "Region": "us-east-1",
        "AccessKeyId": "minioadmin",
        "SecretAccessKey": "minioadmin",
        "Description": "Local S3-compatible emulator (MinIO) for testing",
        "UseForDemo": true
      }
    }
  }
}
